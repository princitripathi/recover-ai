RECOVERAI_API_BASE_URL=http://127.0.0.1:8000
RECOVERAI_DATABASE_URL=sqlite:///./recoverai.db
RECOVERAI_DEMO_DATA_PATH=../data/demo_transactions.csv

# LLM Configuration (Ollama)
RECOVERAI_OLLAMA_URL=http://127.0.0.1:11434
RECOVERAI_OLLAMA_MODEL=qwen2.5:3b
RECOVERAI_LLM_TIMEOUT=30

# Policy Engine Configuration
RECOVERAI_MAX_RETRY_AMOUNT=25000.0
RECOVERAI_MAX_PAYMENT_LINK_AMOUNT=50000.0
RECOVERAI_MIN_AI_CONFIDENCE=0.6
RECOVERAI_MAX_RETRY_COUNT=2

# Razorpay Test Mode Configuration
# IMPORTANT: Use TEST MODE credentials only. Never use production keys.
# Get test keys from https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
RAZORPAY_KEY_ID=GOHWFAWdAMnJk9Fp2pK51Gqb
RAZORPAY_KEY_SECRET=rzp_test_TYQ9rvafjvN7z2
# Razorpay API base URL (default: https://api.razorpay.com/v1)
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Razorpay Webhook Secret for HMAC-SHA256 signature verification (X-Razorpay-Signature)
# Configure a webhook at https://dashboard.razorpay.com/app/webhooks pointing to POST /api/webhooks/razorpay
# and paste the secret here. Secrets are never exposed in API responses.
RAZORPAY_WEBHOOK_SECRET=
# Or with prefix: RECOVERAI_RAZORPAY_WEBHOOK_SECRET
